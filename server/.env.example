# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/civic-lens

# Server Port
PORT=5000

# Google Cloud Vision API
# Option 1: Use service account key file (recommended for production)
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Option 2: Use API Key (simpler for development)
# Create at Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLOUD_API_KEY=your_api_key_here

# Gemini API (for advanced NLP - optional)
GEMINI_API_KEY=your_gemini_api_key_here
